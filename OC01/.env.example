# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
#
# Mailpit/MailHog local:
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false

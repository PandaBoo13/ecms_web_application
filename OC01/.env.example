# Copy this file to .env and fill in credentials locally.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/public/tuition/vnpay-return-page
APP_STUDYING_URL=http://localhost:5174
# Public backend/API base URL used in emailed payment links (use the deployed HTTPS API URL for customers).
APP_API_URL=http://localhost:8080

# ── MAIL ───────────────────────────────────────────────────────
